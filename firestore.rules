rules_version = '2';

// 우리들 신문 — Firestore 보안 규칙
// · 처음 '편집위원 로그인'을 한 구글 계정이 편집장(관리자)으로 등록됩니다.
// · 관리자(최대 2명)만 '계정 등록·수정'에서 계정을 추가·수정·삭제할 수 있습니다.
// · 등록된 계정(관리자 + 편집위원)만 신문을 편집할 수 있습니다.
// · 그 밖의 학생·독자는 로그인 없이 신문 읽기와 '나도 기사 쓰기'만 할 수 있습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function membersPath() { return /databases/$(database)/documents/config/members; }
    function members() { return get(membersPath()).data; }

    function isAdmin() {
      return signedIn() && exists(membersPath()) && myEmail() in members().adminEmails;
    }
    function isEditor() {
      return signedIn() && exists(membersPath()) && myEmail() in members().editorEmails;
    }
    // 저장하려는 계정 명단이 올바른 모양인지
    function validMembers(d) {
      return d.adminEmails is list
        && d.editorEmails is list
        && d.adminEmails.size() >= 1
        && d.adminEmails.size() <= 2
        && d.editorEmails.size() <= 12
        && d.editorEmails.hasAll(d.adminEmails)
        && d.accounts is list;
    }

    // ── 계정 명단 ─────────────────────────────
    match /config/members {
      allow read: if isEditor();
      // 처음 한 번: 아직 명단이 없을 때 로그인한 본인만 편집장으로 등록
      allow create: if signedIn()
        && validMembers(request.resource.data)
        && request.resource.data.adminEmails == [myEmail()];
      // 그 뒤로는 관리자만 수정 (관리자는 자기 자신을 관리자에서 뺄 수 없음)
      allow update: if isAdmin()
        && validMembers(request.resource.data)
        && myEmail() in request.resource.data.adminEmails;
      allow delete: if false;
    }

    // ── 공개 정보(편집장 등록 여부): 누구나 읽기 ──
    match /config/public {
      allow read: if true;
      allow write: if signedIn()
        && myEmail() in getAfter(membersPath()).data.adminEmails;
    }

    // ── 지금 만들고 있는 신문 ──
    match /newspaper/current {
      allow read: if true;
      allow write: if isEditor()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
    }

    // ── 신문 사진 ──
    match /images/{imageId} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.data.data is string
        && request.resource.data.data.matches('^data:image/.*')
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if isEditor();
    }

    // ── 발행한 지난 신문 ──
    match /issues/{issueId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ── 학생이 보낸 기사 ──
    match /submissions/{subId} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && (!('image' in request.resource.data)
            || request.resource.data.image.size() < 900000);
      allow read, delete: if isEditor();
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
